# Reference values for local development; export them in your shell or configure
# them through your local environment manager. Do not commit a populated .env.
DATABASE_URL=postgresql://user:password@localhost:5432/gathering_fallen_live
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Public Clerk publishable key used by the Vite build.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Optional override. Cloudflare and the API server default to this same-origin path.
VITE_CLERK_PROXY_URL=/api/__clerk